{
  "name": "tech-blog.s-yoshiki.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "check:fix": "pnpm lint:fix && pnpm format",
    "verify": "pnpm check",
    "start": "turbo run start",
    "export": "turbo run build",
    "textlint": "turbo run textlint",
    "generate:redirects": "turbo run generate:redirects"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
