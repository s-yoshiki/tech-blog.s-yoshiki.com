{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "root": false,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/build",
      "!!**/coverage",
      "!!**/node_modules",
      "!!**/out",
      "!!**/*.tsbuildinfo"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "includes": ["**"],
    "indentWidth": 2,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "domains": {
      "drizzle": "none",
      "next": "all",
      "playwright": "none",
      "project": "none",
      "qwik": "none",
      "react": "all",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "all",
      "test": "none",
      "turborepo": "all",
      "types": "all",
      "vue": "none"
    },
    "rules": {
      "preset": "all"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/app/about/page.tsx",
        "**/src/app/about/portfolio/page.tsx",
        "**/src/app/page.tsx",
        "**/src/components/features/article/article-page.tsx",
        "**/src/components/layout/theme-script.tsx"
      ],
      "linter": {
        "rules": {
          "security": { "noDangerouslySetInnerHtml": "off" }
        }
      }
    },
    {
      "includes": [
        "**/src/app/layout.tsx",
        "**/src/components/features/article/article-page.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": { "useUniqueElementIds": "off" }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
