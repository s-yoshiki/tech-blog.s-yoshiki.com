{
  "name": "@tech-blog/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "export": "next build --turbopack",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tools package.json next.config.mjs tsconfig.json knip.jsonc",
    "format:check": "oxfmt --check src tools package.json next.config.mjs tsconfig.json knip.jsonc",
    "typecheck": "tsc --noEmit",
    "textlint": "textlint --rule no-mix-dearu-desumasu --rule max-ten --rule spellcheck-tech-word ./content",
    "generate:redirects": "node tools/redirect/generater.js"
  },
  "dependencies": {
    "@mdx-js/loader": "catalog:",
    "@mdx-js/react": "catalog:",
    "@next/mdx": "catalog:",
    "@repo/blog-content": "workspace:*",
    "@repo/ui": "workspace:*",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-frontmatter": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "textlint": "catalog:",
    "textlint-rule-max-ten": "catalog:",
    "textlint-rule-no-mix-dearu-desumasu": "catalog:",
    "textlint-rule-spellcheck-tech-word": "catalog:",
    "typescript": "catalog:"
  }
}
