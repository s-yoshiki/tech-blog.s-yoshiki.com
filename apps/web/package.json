{
  "name": "@tech-blog/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "export": "next build",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome check --write --formatter-enabled=true --linter-enabled=false --assist-enabled=true src next.config.mjs postcss.config.mjs",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=true src next.config.mjs postcss.config.mjs",
    "typecheck": "tsc --noEmit",
    "textlint": "textlint --rule no-mix-dearu-desumasu --rule max-ten --rule spellcheck-tech-word ./content",
    "generate:redirects": "node tools/redirect/generater.js"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-frontmatter": "^5.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@shikijs/rehype": "^4.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "postcss": "^8.5.26",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "textlint": "^15.8.0",
    "textlint-rule-max-ten": "^5.0.0",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-spellcheck-tech-word": "^5.0.0",
    "typescript": "7.0.2",
    "unified": "^11.0.5"
  }
}
